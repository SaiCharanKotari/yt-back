# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/clipflow?retryWrites=true&w=majority

# Session & Encryption Security Secrets (32+ bytes)
SESSION_SECRET=your_super_secret_session_key_at_least_32_bytes_long
ENCRYPTION_KEY=your_application_level_32_byte_secret_key_here!

# ─── OWNER MASTER GOOGLE DRIVE STORAGE (Centralized 2TB+ Pool) ───────────────
# Enter the Owner Google OAuth credentials & authorized Refresh Token below:
GOOGLE_MASTER_CLIENT_ID=
GOOGLE_MASTER_CLIENT_SECRET=
GOOGLE_MASTER_REFRESH_TOKEN=
GOOGLE_MASTER_ROOT_FOLDER_NAME=ClipFlow

# Google OAuth 2.0 (For optional 1-click user Google Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# OpenRouter AI (Optional)
OPENROUTER_API_KEY=

# SMTP / Email Configuration (Optional - logs verification tokens to console if missing)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@clipflow.app
